// ---------- Sensor Pins ----------
#define MQ136_PIN 27
#define MQ3_PIN 33
#define MQ137_PIN 12

// ---------- Buzzer Pin ----------
#define BUZZER_PIN 25

// ---------- Constants ----------
const int CALIBRATION_SAMPLES = 50; 
const float RL = 10.0;              // Load resistor in kΩ
const float ADC_MAX = 4095.0;       
const float VREF = 3.3;             

// ---------- Objects ----------
// OLED Display (Ensure wiring: SDA=21, SCL=22 on standard ESP32)
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, U8X8_PIN_NONE);

// ---------- Globals ----------
float Ro3 = 10.0, Ro136 = 10.0, Ro137 = 10.0; // Defaults
bool calibrated = false;
int last_predicted_class = -1;

// Class Mapping (Update your ESP32 code with this):
//    0 = After_smoke
//    1 = Butane
//    2 = No_Gas
//    3 = Smoke
// // ---------------------------------------------------------

const char* CLASS_NAMES[] = {
  "After_smoke",    // 1
  "Butane",     // 2
  "No_Gas", // 3
  "Smoke"    // 4
};
const int MAX_CLASSES = 5;

// ---------- KNN Structures ----------
struct Neighbor {
    float distance;
    int label;
};

// ---------- Helper Functions: Sensors ----------
float readSensorVoltage(int pin) {
    int adcValue = analogRead(pin);
    return (adcValue * VREF / ADC_MAX);
}

float calculateRs(float vOut) {
    if (vOut <= 0.0 || vOut >= VREF) return -1.0;
    return RL * (VREF - vOut) / vOut;
}

void calibrateSensors() {
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_ncenB08_tr);
    u8g2.drawStr(10, 20, "Calibrating...");
    u8g2.drawStr(10, 40, "Keep air clean!");
    u8g2.sendBuffer();
    
    Serial.println("--- Starting Calibration ---");
    float sum3 = 0, sum136 = 0, sum137 = 0;
    
    for (int i = 0; i < CALIBRATION_SAMPLES; i++) {
        sum3 += calculateRs(readSensorVoltage(MQ3_PIN));
        sum136 += calculateRs(readSensorVoltage(MQ136_PIN));
        sum137 += calculateRs(readSensorVoltage(MQ137_PIN));
        delay(500);
        Serial.printf(".\n");
    }
    
    Ro3 = sum3 / CALIBRATION_SAMPLES;
    Ro136 = sum136 / CALIBRATION_SAMPLES;
    Ro137 = sum137 / CALIBRATION_SAMPLES;
    calibrated = true;
    
    Serial.printf("Ro3: %.2f | Ro136: %.2f | Ro137: %.2f\n", Ro3, Ro136, Ro137);
}

// ---------- Helper Functions: Machine Learning ----------

// 1. Scale Features: (Input - Mean) / Scale
void scaleFeatures(float* raw, float* scaled) {
    for (int i = 0; i < NUM_FEATURES; i++) {
        scaled[i] = (raw[i] - SCALER_MEAN[i]) / SCALER_SCALE[i];
    }
}

// 2. KNN Inference
int predictLabel(float* scaled_input) {
    Neighbor neighbors[K_NEIGHBORS];
    
    // Init neighbors with max distance
    for (int i = 0; i < K_NEIGHBORS; i++) {
        neighbors[i].distance = 999999.0;
        neighbors[i].label = -1;
    }

    // Scan dataset
    for (int i = 0; i < NUM_SAMPLES; i++) {
        float dist_sq = 0.0;
        for (int j = 0; j < NUM_FEATURES; j++) {
            float diff = scaled_input[j] - TRAIN_X[i][j];
            dist_sq += diff * diff;
        }

        // Insertion Sort logic for top K
        if (dist_sq < neighbors[K_NEIGHBORS-1].distance) {
            neighbors[K_NEIGHBORS-1].distance = dist_sq;
            neighbors[K_NEIGHBORS-1].label = TRAIN_Y[i];
            
            // Bubble up
            for (int k = K_NEIGHBORS-1; k > 0; k--) {
                if (neighbors[k].distance < neighbors[k-1].distance) {
                    Neighbor temp = neighbors[k];
                    neighbors[k] = neighbors[k-1];
                    neighbors[k-1] = temp;
                } else {
                    break;
                }
            }
        }
    }

    // Voting
    int votes[MAX_CLASSES] = {0};
    for (int i = 0; i < K_NEIGHBORS; i++) {
        if (neighbors[i].label >= 0 && neighbors[i].label < MAX_CLASSES) {
            votes[neighbors[i].label]++;
        }
    }

    // Find Winner
    int max_votes = -1;
    int winner = 0;
    for (int i = 0; i < MAX_CLASSES; i++) {
        if (votes[i] > max_votes) {
            max_votes = votes[i];
            winner = i;
        }
    }
    return winner;
}

// ---------- Main Setup ----------
void setup() {
    Serial.begin(115200);
    pinMode(BUZZER_PIN, OUTPUT);
    digitalWrite(BUZZER_PIN, LOW);
    
    // OLED Init
    u8g2.begin();
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_ncenB10_tr);
    u8g2.drawStr(15, 30, "AI Nose Ready");
    u8g2.sendBuffer();
    delay(1000);
    
    calibrateSensors();
}

// ---------- Main Loop ----------
void loop() {
    // 1. Collect 5 samples to calculate averages and slopes
    float v3, v136, v137;
    float mq3_vals[5], mq136_vals[5], mq137_vals[5];
    
    // Sampling Loop (takes ~1.5 seconds with delay)
    for(int i=0; i<5; i++) {
        v3 = readSensorVoltage(MQ3_PIN);
        v136 = readSensorVoltage(MQ136_PIN);
        v137 = readSensorVoltage(MQ137_PIN);
        
        mq3_vals[i] = calculateRs(v3) / Ro3;
        mq136_vals[i] = calculateRs(v136) / Ro136;
        mq137_vals[i] = calculateRs(v137) / Ro137;
        
        delay(300); // Wait between samples
    }
    
    // 2. Calculate Averages (Current State)
    float avg_mq3 = 0, avg_mq136 = 0, avg_mq137 = 0;
    for(int i=0; i<5; i++) {
        avg_mq3 += mq3_vals[i];
        avg_mq136 += mq136_vals[i];
        avg_mq137 += mq137_vals[i];
    }
    avg_mq3 /= 5.0;
    avg_mq136 /= 5.0;
    avg_mq137 /= 5.0;
    
    // 3. Calculate Slopes (Change over time)
    // Using simple difference of last vs first or average of step-changes
    // Matched to your logic: Average of step changes
    float slope3_sum = 0, slope136_sum = 0, slope137_sum = 0;
    for(int i=0; i<4; i++) {
        slope3_sum += (mq3_vals[i+1] - mq3_vals[i]) * 100.0 / mq3_vals[i];
        slope136_sum += (mq136_vals[i+1] - mq136_vals[i]) * 100.0 / mq136_vals[i];
        slope137_sum += (mq137_vals[i+1] - mq137_vals[i]) * 100.0 / mq137_vals[i];
    }
    float avg_slope3 = slope3_sum / 4.0;
    float avg_slope136 = slope136_sum / 4.0;
    float avg_slope137 = slope137_sum / 4.0;
    
    // 4. Prepare Feature Vector [MQ3, MQ136, MQ137, S3, S136, S137]
    float raw_features[6] = {
        avg_mq3, avg_mq136, avg_mq137,
        avg_slope3, avg_slope136, avg_slope137
    };
    
    float scaled_features[6];
    
    // 5. Run ML Pipeline
    long start_time = millis();
    
    scaleFeatures(raw_features, scaled_features);
    int predicted_class = predictLabel(scaled_features);
    
    long duration = millis() - start_time;
    
    // 6. Handle Output
    const char* pred_name = (predicted_class < MAX_CLASSES) ? CLASS_NAMES[predicted_class] : "Error";
    
    Serial.printf("MQ3:%.2f S:%.2f | MQ136:%.2f S:%.2f | Class: %s (%d ms)\n", avg_mq3, avg_slope3, avg_mq136, avg_slope136, pred_name, duration);
    
    // 7. Update OLED
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_ncenB10_tr);
    u8g2.drawStr(0, 15, "Status:");
    
    u8g2.setFont(u8g2_font_ncenB12_tr);
    u8g2.drawStr(10, 45, pred_name); // Big Font for Result
    
    // Draw small latency info
    // u8g2.setFont(u8g2_font_u8glib_4_tf);
    // u8g2.setCursor(80, 60);
    // u8g2.print(duration);
    // u8g2.print("ms");
    
    u8g2.sendBuffer();
    
    // 8. Buzzer Logic (If Class Changed)
    if (predicted_class != last_predicted_class) {
        if (predicted_class != 0) { // If not "No Gas" (assuming 0 is safe)
            digitalWrite(BUZZER_PIN, HIGH);
            delay(200);
            digitalWrite(BUZZER_PIN, LOW);
            delay(100);
            digitalWrite(BUZZER_PIN, HIGH);
            delay(200);
            digitalWrite(BUZZER_PIN, LOW);
        }
        last_predicted_class = predicted_class;
    }
    
    // Small delay before next scan cycle
    delay(500); 
}
